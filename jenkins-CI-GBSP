pipeline{
  agent any
  options{
    buildDiscarder(logRotator(numToKeepStr:'10'))
    timeout(time: 1, unit: 'HOURS')
  }
  stages{
    stage('Build'){
      steps{
        script{
          sh 'echo "Compiling code ......"'
        }
      }
    }
    stage('Test'){
      when{
          changeRequest()
        }
        steps{
          script{
            sh 'echo "Running PR Tests"'
        }
      }
    }
    stage('Deploy'){
      when{
        branch 'main'
      }
      steps{
        script{
          sh 'echo "Deploying to Production"'
        }
      }
    }
  }
  post{
    always{
      sh 'echo "i will always run, no matter what!!"'
    }
	 success{
      	  slackSend(
                color: "good",
                message: "✅ Build Success! \n Project: ${env.JOB_NAME} \n  Build: ${env.BUILD_NUMBER} \n URL: ${env.BUILD_URL}",
      sh 'echo "Notify team: Build success"'
   	) 
    }
    	failure{
      	 slackSend(
                color: "danger",
                message: "❌ Build Failed! \n Project: ${env.JOB_NAME} \n  Build: ${env.BUILD_NUMBER} \n URL: ${env.BUILD_URL}",
      sh 'echo "Notify team: Build failed"'
	)
    }
  }
}
